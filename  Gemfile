source "https://rubygems.org"

ruby "3.2.2"

gem "rails", "~> 7.1.6"
gem "sprockets-rails"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "jbuilder"
gem "bootsnap", require: false
gem "devise"
gem 'json', '< 3.0'

# Windows用の設定
gem "tzinfo-data", platforms: %i[ windows jruby ]

# 開発環境、テスト環境共通のツール（#8 #9 #10用）
group :development, :test do
  gem "debug", platforms: %i[ mri windows ]
  gem "rspec-rails"
  gem "factory_bot_rails"
  gem "rubocop-rails", require: false
end

# 開発環境限定（#19 Bullet用）
group :development do
  gem "web-console"
  gem "bullet"
end

# テスト環境限定（#8 SimpleCov、RSpec用）
group :test do
  gem "capybara"
  gem "selenium-webdriver"
  gem "simplecov", require: false
end
