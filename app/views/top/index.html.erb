<header style="display: flex; justify-content: space-between; align-items: center; padding: 15px; background-color: #ccc;">
  <h2>Nokoripo</h2>
  
  <div>
    <% if user_signed_in? %>
      <!-- ログインしている時の表示 -->
      <span style="margin-right: 15px;">ログイン中: <%= current_user.email %></span>
      <%= button_to "ログアウト", destroy_user_session_path, method: :delete, style: "background: none; border: none; color: red; text-decoration: underline; cursor: pointer; display: inline;" %>
    <% else %>
      <!-- 画面遷移図通り：未ログイン時のヘッダー表示 -->
      <%= link_to "新規登録", new_user_registration_path, style: "margin-right: 15px; padding: 5px 10px; background: white; border: 1px solid #000; text-decoration: none;" %>
      <%= link_to "ログイン", new_user_session_path, style: "padding: 5px 10px; background: white; border: 1px solid #000; text-decoration: none;" %>
    <% end %>
  </div>
</header>

<main style="text-align: center; margin-top: 50px;">
  <h1>Nokoripo</h1>
  <div style="background-color: #f0f0f0; width: 300px; height: 150px; margin: 20px auto; display: flex; align-items: center; justify-content: center;">
    アプリの説明（ここにメーターの動機が入ります）
  </div>

  <div>
    <% if user_signed_in? %>
      <!-- ログインしていたら、メイン画面（ダッシュボード等）へのボタンにする -->
      <%= link_to 'メーターへ移動', dashboard_path, class: 'btn btn-primary' %>

    <% else %>
      <!-- 画面遷移図通り：メーターをつくるボタン（新規登録へ） -->
      <%= link_to "メーターをつくる", new_user_registration_path, style: "padding: 10px 20px; background: #bbb; border: 1px solid #000; text-decoration: none;" %>
    <% end %>
  </div>
</main>
