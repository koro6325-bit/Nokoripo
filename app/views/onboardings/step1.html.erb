<div class="container mx-auto p-4" style="max-width: 1400px; width: 95%; font-family: sans-serif; color: #374151;">
  
  <!-- ヘッダーエリア（画面いっぱいに広がる美しいレイアウト） -->
  <div class="flex justify-between items-center mb-6 p-4 rounded" style="background-color: #f3f4f6; display: flex; justify-content: space-between; align-items: center; border-radius: 0.5rem; width: 100%; box-sizing: border-box;">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <h1 class="text-xl font-bold" style="margin: 0; font-size: 1.25rem;">Nokoripo</h1>
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <div style="width: 24px; height: 24px; background-color: #d1d5db; border-radius: 50%;"></div>
        <span style="font-size: 0.875rem; color: #374151; font-weight: bold;">ユーザー名: <%= current_user.nickname.presence || "ゲスト" %></span>
      </div>
    </div>
    <div>
      <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, style: "color: #374151; background-color: #ffffff; border: 1px solid #d1d5db; text-decoration: none; font-size: 0.875rem; padding: 0.375rem 0.75rem; border-radius: 0.25rem;" %>
    </div>
  </div>

  <p style="color: #3b82f6; font-size: 0.95rem; font-weight: bold; margin-bottom: 0.5rem; background-color: #eff6ff; padding: 0.25rem 1rem; border-radius: 9999px; display: inline-block;">ステップ1 / 2</p>

  <%= form_with model: @user, url: update_step1_onboardings_path, method: :patch, local: true do |f| %>
    <!-- メメイン入力カード（フルワイド対応） -->
    <div style="background-color: #ffffff; border: 2px solid #e5e7eb; border-radius: 1rem; padding: 3.5rem 2rem; margin-bottom: 1.5rem; position: relative; width: 100%; box-sizing: border-box;">
      
      <!-- 吹き出しメッセージエリア -->
      <div style="text-align: center; margin-bottom: 2rem; display: flex; justify-content: center; align-items: center; gap: 8px;">
        <div style="background-color: #f3f4f6; padding: 0.75rem 2rem; border-radius: 0.5rem; border-left: 4px solid #3b82f6; font-weight: bold; font-size: 1.1rem; color: #1f2937;">
          「だいたいでOKだよ！今月の最大HP（使っていいお金）を教えてね！」
        </div>
      </div>

      <!-- リアルタイムに変動する金額表示 -->
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <span id="hp-display" style="font-size: 3.5rem; font-weight: 800; color: #111827;">10</span>
        <span style="font-size: 2rem; font-weight: 800; color: #111827;">万円</span>
      </div>

      <!-- スライダーフォーム（フルワイドの幅に綺麗に追従） -->
      <div style="margin-bottom: 3.5rem; padding: 0 2rem;">
        <%= f.range_field :monthly_allowance, id: "hp-slider", min: 1, max: 30, value: 10, style: "width: 100%; -webkit-appearance: none; background: #e5e7eb; height: 8px; border-radius: 9999px; outline: none; cursor: pointer;" %>
      </div>

      <!-- クイック選択ボタン（広い画面幅に合わせて押しやすくボリュームアップ） -->
      <div style="display: flex; justify-content: space-between; gap: 20px; padding: 0 2rem; flex-wrap: wrap;">
        <button type="button" onclick="selectHP(5)" style="flex: 1; min-width: 150px; background-color: #e5e7eb; border: none; padding: 1rem 0; border-radius: 0.375rem; font-weight: bold; color: #374151; cursor: pointer; font-size: 1rem; transition: background-color 0.2s;">5万円</button>
        <button type="button" onclick="selectHP(10)" style="flex: 1; min-width: 150px; background-color: #e5e7eb; border: none; padding: 1rem 0; border-radius: 0.375rem; font-weight: bold; color: #374151; cursor: pointer; font-size: 1rem; transition: background-color 0.2s;">10万円</button>
        <button type="button" onclick="selectHP(15)" style="flex: 1; min-width: 150px; background-color: #e5e7eb; border: none; padding: 1rem 0; border-radius: 0.375rem; font-weight: bold; color: #374151; cursor: pointer; font-size: 1rem; transition: background-color 0.2s;">15万円</button>
      </div>
    </div>

    <!-- 下部ナビゲーションボタン（フルサイズ対応） -->
    <div style="display: flex; justify-content: space-between; gap: 24px; padding: 0 2rem; margin-top: 2rem;">
      <%= link_to "戻る", :back, style: "flex: 1; text-align: center; background-color: #e5e7eb; color: #374151; padding: 1rem 0; border-radius: 0.375rem; font-weight: bold; text-decoration: none; font-size: 1rem;" %>
      <%= f.submit "次へ進む 🚀", style: "flex: 2; text-align: center; background-color: #3b82f6; color: white; padding: 1rem 0; border-radius: 0.375rem; font-weight: bold; font-size: 1.1rem; border: none; cursor: pointer; box-shadow: 0 4px 6px rgba(59,130,246,0.2);" %>
    </div>
  <% end %>
</div>

<!-- スライダーやクイックボタンと連動して数字をパッと変えるJavaScript -->
<script>
  const slider = document.getElementById('hp-slider');
  const display = document.getElementById('hp-display');

  slider.addEventListener('input', function() {
    display.textContent = this.value;
  });

  function selectHP(amount) {
    slider.value = amount;
    display.textContent = amount;
  }
</script>


  #hp-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #3b82f6;
    cursor: pointer;
    border: 3px solid #ffffff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }
  #hp-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #3b82f6;
    cursor: pointer;
    border: 3px solid #ffffff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }
</style>

