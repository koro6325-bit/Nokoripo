<div class="container mx-auto p-4" style="max-width: 600px; font-family: sans-serif; color: #374151; padding-top: 2rem;">
  
  <!-- ステップ表示 -->
  <div style="font-size: 0.875rem; color: #9ca3af; text-align: center; margin-bottom: 1rem; font-weight: bold;">
    ステップ 1 / 2
  </div>

  <%= form_with model: @user, url: registrations_step_path('allowance'), method: :patch, local: true do |f| %>
    
    <!-- 中央のホワイトカード -->
    <div style="background-color: #ffffff; padding: 2.5rem 1.5rem; border-radius: 0.75rem; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); text-align: center; margin-bottom: 2rem; position: relative;">
      
      <!-- 親しみやすい吹き出し風ガイド -->
      <div style="display: inline-block; background-color: #e5e7eb; padding: 0.375rem 1rem; border-radius: 0.25rem; font-weight: bold; font-size: 0.875rem; margin-bottom: 1rem;">
        今月の最大HPは？
      </div>

      <!-- リアルタイムで変動する金額表示（初期値は100,000円） -->
      <div style="margin-bottom: 2rem;">
        <span id="display-amount" style="font-size: 2.5rem; font-weight: 800; color: #111827;">100,000</span>
        <span style="font-size: 1.5rem; font-weight: bold; color: #111827; margin-left: 0.25rem;">円</span>
      </div>

      <!-- 💡 スライダーUI（1万円〜30万円まで1,000円刻みで直感的に動かせます） -->
      <div style="margin-bottom: 2.5rem; padding: 0 1rem;">
        <%= f.range_field :monthly_allowance, id: "allowance-slider", min: 10000, max: 300000, step: 1000, value: @user.monthly_allowance || 100000, style: "width: 100%; accent-color: #3b82f6; cursor: pointer; height: 6px; background: #e5e7eb; border-radius: 9999px;" %>
      </div>

      <!-- 💡 クイック選択ボタン（押すとスライダーと中央の数字がその金額に一瞬で切り替わります） -->
      <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <button type="button" onclick="setAllowance(50000)" style="background-color: #e5e7eb; border: none; padding: 0.625rem 1.5rem; border-radius: 0.25rem; font-size: 0.875rem; cursor: pointer; font-weight: bold; color: #374151;">5万円</button>
        <button type="button" onclick="setAllowance(100000)" style="background-color: #e5e7eb; border: none; padding: 0.625rem 1.5rem; border-radius: 0.25rem; font-size: 0.875rem; cursor: pointer; font-weight: bold; color: #374151;">10万円</button>
        <button type="button" onclick="setAllowance(150000)" style="background-color: #e5e7eb; border: none; padding: 0.625rem 1.5rem; border-radius: 0.25rem; font-size: 0.875rem; cursor: pointer; font-weight: bold; color: #374151;">15万円</button>
      </div>
    </div>

    <!-- 下部ナビゲーションボタン（戻る・次へ） -->
    <div style="display: flex; justify-content: space-between; align-items: center; max-width: 400px; margin: 0 auto; gap: 20px;">
      <%= link_to "戻る", dashboard_path, style: "background-color: #e5e7eb; color: #374151; padding: 0.75rem 2rem; border-radius: 0.25rem; font-weight: bold; text-decoration: none; font-size: 1rem; text-align: center; flex: 1;" %>
      <%= f.submit "次へ", style: "background-color: #3b82f6; color: white; padding: 0.75rem 2rem; border: none; border-radius: 0.25rem; font-weight: bold; cursor: pointer; font-size: 1rem; flex: 1;" %>
    </div>

  <% end %>
</div>

<!-- 💡 スライダーとボタンの数値をリアルタイム連動させる魔法のJavaScript -->
<script>
  const slider = document.getElementById('allowance-slider');
  const display = document.getElementById('display-amount');

  // カンマ区切りのフォーマット関数
  function formatNumber(num) {
    return Number(num).toLocaleString();
  }

  // スライダーを動かした時のイベント
  slider.addEventListener('input', (e) => {
    display.textContent = formatNumber(e.target.value);
  });

  // クイックボタンを押した時の処理
  function setAllowance(amount) {
    slider.value = amount;
    display.textContent = formatNumber(amount);
  }

  // 画面を開いた時の初期表示
  window.addEventListener('DOMContentLoaded', () => {
    display.textContent = formatNumber(slider.value);
  });
</script>

