<!-- app/views/registrations_steps/allowance.html.erb -->
<div class="container mx-auto p-4">
  <p class="text-sm text-gray-500">ステップ 1 / 2</p>
  <h2 class="text-2xl font-bold mb-4">今月の最大HP（使っていいお金）は？</h2>
  
  <div class="bg-blue-50 p-4 rounded mb-4">
    <p class="text-blue-600">「だいたいでOKだよ！」</p>
  </div>

  <%= form_with model: @user, url: registrations_step_path(:allowance), method: :patch, local: true do |f| %>
    <div class="mb-4">
      <!-- ズボラ設計対策：あらかじめ10万円(100000)を初期値としてセット -->
      <%= f.number_field :monthly_allowance, value: @user.monthly_allowance || 100000, class: "input input-bordered w-full" %>
    </div>

    <!-- ここに画面遷移図にある5万、10万、15万のクイック選択ボタンやスライダーUIを実装していきます -->

    <div class="flex justify-end">
      <%= f.submit "次へ", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
