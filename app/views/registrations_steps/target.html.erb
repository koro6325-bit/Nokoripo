<div class="container mx-auto p-4" style="max-width: 600px; font-family: sans-serif; color: #374151; padding-top: 2rem;">
  
  <!-- ステップ表示 -->
  <div style="font-size: 0.875rem; color: #9ca3af; text-align: center; margin-bottom: 1rem; font-weight: bold;">
    ステップ 2 / 2
  </div>

  <%= form_with model: @target, url: registrations_step_path('target'), method: :patch, local: true do |f| %>
    
    <!-- Rails標準のエラーポップアップ表示エリア（バリデーションエラー時） -->
    <% if @target.errors.any? %>
      <script>
        alert("<%= j @target.errors.full_messages.join('\n') %>");
      </script>
    <% end %>

    <!-- 中央のホワイトカード -->
    <div style="background-color: #ffffff; padding: 2.5rem 2rem; border-radius: 0.75rem; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 2rem;">
      
      <!-- 1. 目標名前フォーム -->
      <div style="margin-bottom: 2rem; display: flex; flex-direction: column; align-items: flex-start; max-width: 400px; margin-left: auto; margin-right: auto;">
        <label style="font-weight: bold; font-size: 1rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          目標
        </label>
        <%= f.text_field :name, style: "border: 1px solid #d1d5db; padding: 0.625rem; width: 100%; border-radius: 9999px; box-sizing: border-box; text-align: center; font-size: 0.95rem;", placeholder: "12月の旅行" %>
      </div>

      <!-- 2. 死守する金額表示（スライダーと連動） -->
      <div style="text-align: center; margin-bottom: 1.5rem; display: flex; justify-content: center; align-items: center; gap: 1.5rem;">
        <span style="font-weight: bold; font-size: 1rem; color: #374151;">死守する金額</span>
        <div>
          <span id="display-target-amount" style="font-size: 2.25rem; font-weight: 800; color: #111827;">50,000</span>
          <span style="font-size: 1.25rem; font-weight: bold; color: #111827; margin-left: 0.25rem;">円</span>
        </div>
      </div>

      <!-- 💡 死守する金額のスライダーUI（1万円〜20万円まで5,000円刻み） -->
      <div style="margin-bottom: 1.5rem; padding: 0 2rem;">
        <%= f.range_field :total_budget, id: "target-slider", min: 10000, max: 200000, step: 5000, value: @target.total_budget || 50000, style: "width: 100%; accent-color: #3b82f6; cursor: pointer; height: 6px; background: #e5e7eb; border-radius: 9999px;" %>
      </div>
    </div>

    <!-- 下部ナビゲーションボタン（決定・戻る） -->
    <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; max-width: 250px; margin: 0 auto;">
      <%= f.submit "決定", style: "background-color: #e5e7eb; color: #374151; padding: 0.75rem; border: none; border-radius: 0.25rem; font-weight: bold; cursor: pointer; font-size: 1rem; width: 100%; text-align: center;" %>
      <%= link_to "戻る", registrations_step_path('allowance'), style: "background-color: #e5e7eb; color: #374151; padding: 0.75rem; border-radius: 0.25rem; font-weight: bold; text-decoration: none; font-size: 1rem; width: 100%; text-align: center; box-sizing: border-box;" %>
    </div>

  <% end %>
</div>

<!-- 💡 スライダーの数値をリアルタイム連動させるJavaScript -->
<script>
  const targetSlider = document.getElementById('target-slider');
  const targetDisplay = document.getElementById('display-target-amount');

  function formatNumber(num) {
    return Number(num).toLocaleString();
  }

  targetSlider.addEventListener('input', (e) => {
    targetDisplay.textContent = formatNumber(e.target.value);
  });

  window.addEventListener('DOMContentLoaded', () => {
    targetDisplay.textContent = formatNumber(targetSlider.value);
  });
</script>

