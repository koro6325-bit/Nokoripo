<!-- app/views/registrations_steps/target.html.erb -->
<div class="container mx-auto p-4" style="max-width: 500px; margin-top: 40px;">
  <p class="text-sm text-gray-500">ステップ 2 / 2</p>
  
  <div class="card bg-white p-6 rounded shadow-lg border mt-2">
    
    <!-- エラー表示エリア -->
    <% if @target.errors.any? %>
      <div class="bg-red-100 text-red-700 p-3 rounded mb-4 text-sm">
        <ul>
          <% @target.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @target, url: registrations_step_path(:target), method: :patch, local: true do |f| %>
      
      <!-- 1. 目標の名前入力欄 -->
      <div class="mb-6">
        <%= f.label :name, "目標", class: "block font-bold mb-2 text-gray-700" %>
        <%= f.text_field :name, class: "border p-2 w-full rounded", placeholder: "12月の旅行", required: true %>
      </div>

      <!-- 2. 死守する金額（総予算）の表示とスライダー -->
      <div class="mb-6 text-center">
        <label class="block font-bold mb-2 text-left text-gray-700">死守する金額</label>
        
        <!-- 金額を大きく表示するエリア（初期値10万円） -->
        <div class="text-3xl font-black my-4 text-gray-800">
          <span id="budget-offset-val">10</span>万円
        </div>

        <!-- Figma仕様のスライダーUI（5万〜15万などの調整用、裏側で数値を送るためのもの） -->
        <!-- ※一旦手入力用の隠しフォーム（hidden）か、スライダー自体を数値入力の箱として扱います -->
        <%= f.range_field :total_budget, min: 10000, max: 300000, step: 10000, value: 100000, class: "w-full cursor-pointer", id: "budget-slider" %>
        
        <div class="flex justify-between text-xs text-gray-400 mt-1">
          <span>1万円</span>
          <span>30万円</span>
        </div>
      </div>

      <!-- 3. 目標期限（Figmaの裏側や今後のために今日の日付などを仮で送るか、フォームを隠し持ちます） -->
      <%= f.hidden_field :deadline, value: Time.current.to_date + 1.month %>

      <!-- ボタンエリア -->
      <div class="mt-8">
        <%= f.submit "決定", class: "w-full bg-gray-400 text-white font-bold p-3 rounded hover:bg-gray-500 mb-3 cursor-pointer" %>
      </div>

    <% end %>
  </div>

  <div class="text-center mt-4">
    <%= link_to "戻る", registrations_step_path(:allowance), class: "text-gray-500 underline text-sm" %>
  </div>
</div>

<!-- スライダーの数字を画面の「○○万円」に連動させる簡易JavaScript（あとからHotwire等に置き換えてもOKです！） -->
<script>
  document.addEventListener("turbo:load", () => {
    const slider = document.getElementById("budget-slider");
    const display = document.getElementById("budget-offset-val");
    if (slider && display) {
      slider.addEventListener("input", (e) => {
        const manYen = Math.floor(e.target.value / 10000);
        display.textContent = manYen;
      });
    }
  });
</script>
