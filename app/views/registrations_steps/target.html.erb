<!-- app/views/registrations_steps/target.html.erb -->
<div class="container mx-auto p-4">
  <p class="text-sm text-gray-500">ステップ 2 / 2</p>
  <h2 class="text-2xl font-bold mb-4">今月のモチベ（欲しいもの・目標）を設定しよう！</h2>

  <!-- バリデーションエラー表示用のポップアップエリア -->
  <% if @target.errors.any? %>
    <div class="bg-red-100 text-red-700 p-3 rounded mb-4">
      <ul>
        <% @target.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @target, url: registrations_step_path(:target), method: :patch, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :name, "目標の名前（例: 12月の旅行）", class: "label" %>
      <%= f.text_field :name, class: "input input-bordered w-full", placeholder: "何に使うの〜？" %>
    </div>

    <div class="mb-4">
      <%= f.label :total_budget, "総予算（円）", class: "label" %>
      <%= f.number_field :total_budget, class: "input input-bordered w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :deadline, "目標期限", class: "label" %>
      <%= f.date_field :deadline, class: "input input-bordered w-full" %>
    </div>

    <div class="flex justify-between mt-6">
      <%= link_to "戻る", registrations_step_path(:allowance), class: "btn btn-outline" %>
      <%= f.submit "決定", class: "btn btn-success" %>
    </div>
  <% end %>
</div>
