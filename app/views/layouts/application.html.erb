<!DOCTYPE html>
<html>
  <head>
    <title>Nokoripo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

<body>
  <% flash.each do |key, value| %>
    <div class="flash <%= key %>" style="background-color: #d1e7dd; color: #0f5132; padding: 10px; margin-bottom: 15px; border-radius: 5px;">
      <%= value %>
    </div>
  <% end %>

  <%= yield %>
</body>
</html>
