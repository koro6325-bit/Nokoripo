<% if notice.present? %>
  <div style="background-color: #d1fae5; color: #065f46; padding: 12px 16px; margin-bottom: 16px; border-radius: 6px; font-weight: bold;">
    <%= notice %>
  </div>
<% end %>

<% if alert.present? %>
  <div style="background-color: #fee2e2; color: #991b1b; padding: 12px 16px; margin-bottom: 16px; border-radius: 6px; font-weight: bold;">
    <%= alert %>
  </div>
<% end %>
