
<div class="container mx-auto p-4" style="max-width: 1400px; width: 95%; font-family: sans-serif; color: #374151;">
  
  <!-- 非同期（Turbo）でフラッシュメッセージだけをパッと差し替えるエリア -->
  <div id="flash-messages">
    <%= render "shared/flash" %>
  </div>

  <!-- ヘッダーエリア -->
  <div class="flex justify-between items-center mb-6 p-4 rounded" style="background-color: #f3f4f6; display: flex; justify-content: space-between; align-items: center; border-radius: 0.5rem; width: 100%; box-sizing: border-box;">
    <div style="display: flex; align-items: center; gap: 1.5rem;">
      <h1 class="text-2xl font-bold" style="margin: 0; font-size: 1.5rem; color: #111827;">Nokoripo</h1>
      <span style="font-size: 0.95rem; color: #4b5563; background-color: #e5e7eb; padding: 0.25rem 0.75rem; border-radius: 9999px; font-weight: 500;">ユーザー名: <%= @user.nickname.presence || "ゲスト" %></span>
    </div>
    <div style="display: flex; align-items: center; gap: 15px;">
      <%= link_to "今月の設定を修正", step1_onboardings_path, style: "background-color: #ffffff; color: #374151; border: 1px solid #d1d5db; padding: 0.5rem 1rem; text-decoration: none; border-radius: 0.375rem; font-size: 0.875rem; font-weight: bold; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" %>
      <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, style: "color: #ef4444; text-decoration: none; font-size: 0.95rem; font-weight: bold; margin-left: 5px;" %>
    </div>
  </div>

  <!-- メーター・履歴リスト（フォームもこの中に正しく入っています） -->
  <div id="meter-section" style="width: 100%;">
    <%= render "dashboards/meter_section", user: @user %>
  </div>
</div>





